  "dependencies": {
    "@google/genai": "^2.30.0",
    "@types/cors": "^2.8.19",
    "better-auth": "^1.7.10",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "mongoose": "^9.11.2",
    "vite": "^8.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "tsx": "^4.22.4"
  }
}
